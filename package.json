{
  "name": "openweights",
  "private": true,
  "version": "0.26.1",
  "description": "App desktop open source para rodar LLMs locais (llama.cpp) com harness agêntico — sem terminal, sem CUDA, sem chute de quantização.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedro-canedo/openweights.git"
  },
  "homepage": "https://github.com/pedro-canedo/openweights",
  "bugs": {
    "url": "https://github.com/pedro-canedo/openweights/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/tauri-versions.mjs && node scripts/i18n-parity.mjs && node scripts/docs-parity.mjs && node scripts/contrast-check.mjs && tsc --noEmit && vite build",
    "contrast": "node scripts/contrast-check.mjs",
    "i18n": "node scripts/i18n-parity.mjs",
    "docs": "node scripts/docs-parity.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "bench:render": "node scripts/render-bench.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11",
    "@tauri-apps/plugin-notification": "~2.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^25",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^16",
    "react-markdown": "^10",
    "react-virtuoso": "^4",
    "remark-gfm": "^4",
    "shiki": "^3",
    "uplot": "^1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4",
    "typescript": "~5.9",
    "vite": "^7",
    "vitest": "^5.0.0"
  }
}
